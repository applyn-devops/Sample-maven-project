pipeline {
    agent any

    stages {
        stage('validate') {
            steps {
                sh 'mvn validate'
            }
        }

        stage('compile') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('install') {
            steps {
                sh 'mvn clean install'
            }
    t
    :
    }
}
